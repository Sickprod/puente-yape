<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/marino</item>
        <item name="android:colorPrimaryDark">@color/marino</item>
        <item name="android:colorAccent">@color/azul</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/marino</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">#9AA0A6</item>
    </style>

    <style name="Tarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/tarjeta</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="TituloTarjeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/marino</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gris</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/campo</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="BotonPrincipal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/boton</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BotonTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/boton_texto</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
